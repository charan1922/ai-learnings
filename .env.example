# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_INSTANCE_NAME=
AZURE_OPENAI_ENDPOINT=https://<instance-name>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

# Pinecone (public — exposed to browser)
NEXT_PUBLIC_PINECONE_INDEX=
NEXT_PUBLIC_PINECONE_NAMESPACE=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=

# PostgreSQL
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Redis
REDIS_URL=redis://localhost:6379

# Semantic Cache
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=3600
EMBEDDING_DIM=1536

# IT Agent
IT_TICKETS_NAMESPACE=

# MCP Live Demo (Spec 4): HMAC key that seals elicitation requestState. Optional, 32+ characters.
# Leave unset to use a random key per dev-server start.
# MCP_DEMO_STATE_KEY=

# MCP Live Demo (Specs 8 and 9): Claude API key for Chat mode and the Agent SDK host. Server-side only.
# ANTHROPIC_API_KEY=

# Xiaomi MiMo (Claude protocol) for Specs 8 and 9 — used instead of ANTHROPIC_API_KEY when set.
# Token Plan keys (tp-) use the cluster shown on your Token Plan page, e.g. https://token-plan-sgp.xiaomimimo.com/anthropic
# Pay-as-you-go keys (sk-) use https://api.xiaomimimo.com/anthropic
# MIMO_API_KEY=
# MIMO_API_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
# MIMO_API_MODEL=mimo-v2.6-pro
