# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_INSTANCE_NAME=
AZURE_OPENAI_ENDPOINT=https://<instance-name>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

# Pinecone (public — exposed to browser)
NEXT_PUBLIC_PINECONE_INDEX=
NEXT_PUBLIC_PINECONE_NAMESPACE=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=

# PostgreSQL
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Redis
REDIS_URL=redis://localhost:6379

# Semantic Cache
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=3600
EMBEDDING_DIM=1536

# IT Agent
IT_TICKETS_NAMESPACE=
